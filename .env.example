# Google Gemini API Key (Primary LLM)
GOOGLE_API_KEY=

# Tavily API Key for Live Web Search (News Agent)
TAVILY_API_KEY=

# CricketData.org API Key (used by local MCP server mcp_server/server.py)
CRICKETDATA_API_KEY=

# Local MCP Server Command (stdio transport)
MCP_CRICKET_SERVER_COMMAND=python mcp_server/server.py

# Optional: Remote MCP Server URL
# MCP_CRICKET_SERVER_URL=
